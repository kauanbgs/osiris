# .env.example — modelo das variáveis da API; copie para .env e preencha com os valores reais.
# Nunca use estes valores em produção: JWT_SECRET precisa ser longo e aleatório (ex.: openssl rand -hex 32).
PORT=5000
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=24h
DB_HOST=localhost
DB_PORT=3307
DB_USER=osiris
DB_PASSWORD=troque-esta-senha
DB_NAME=osiris
CORS_ORIGIN=http://localhost:5173
# Opcional: ID do cliente OAuth do Google (pode listar vários, separados por vírgula) para o login com Google.
# GOOGLE_CLIENT_ID=
